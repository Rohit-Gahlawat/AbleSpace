# Postgres connection string.
# Local: docker run --name pyramid-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pyramid?schema=public"

# Port the Nest server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000"

# Signing secret for guest session tokens.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"
